{
  "name": "wangshu",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:api": "pnpm --filter @wangshu/api dev",
    "dev:web": "pnpm --filter @wangshu/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "bash scripts/e2e-local.sh"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.9.3"
  }
}
